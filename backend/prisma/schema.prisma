generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institucion {
  IDInstitucion String @id @default(uuid())

  Email String @unique

  Password String

  NombreInstitucion String

  @@map("instituciones")
}

model Proveedor {
  IDProveedor String @id @default(uuid())

  Email String @unique

  Password String

  NombreEmpresa String

  RazonSocial String?

  @@map("proveedores")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  institucion
  proveedor
}  

model User {
  id           Int    @id @default(autoincrement())
  name_user    String
  razon_social String
  direccion String
  email        String @unique
  password     String
  rol          Role
  organizacion String
  estado_user String
  ciudad_user String
  provincia_user String
  pais_user String
  solicitudes  Solicitud[]
  cotizaciones Cotizacion[]
}

model Solicitud {
  id_solicitud             Int      @id @default(autoincrement())
  titulo_solicitud         String
  equipamiento_solicitud   String
  descripcion_solicitud    String
  cantidad_solicitud       Int
  urgencia_solicitud       String
  estado_solicitud         String
  fecha_creacion_solicitud DateTime @default(now())

  id_institucion     Int
  nombre_institucion String

  especificaciones_solicitud     String
  presupuesto_estimado_solicitud Float

  institucion User @relation(fields: [id_institucion], references: [id])

  cotizaciones Cotizacion[]
}

model Cotizacion {
  id_cotizacion Int @id @default(autoincrement())
  id_solicitud Int
  id_proveedor Int
  nombre_proveedor String
  precio_unitario_cotizacion Float
  precio_total_cotizacion    Float
  plazo_entrega_dias_cotizacion Int
  garantia_meses_cotizacion     Int
  descripcion_cotizacion String
  estado_cotizacion      String
  fecha_envio_cotizacion DateTime @default(now())
  solicitud Solicitud @relation(fields: [id_solicitud], references: [id_solicitud])
  proveedor User @relation(fields: [id_proveedor], references: [id])
  incluye_cotizacion IncluyeCotizacion[]
}

model IncluyeCotizacion {
  id Int @id @default(autoincrement())

  descripcion String

  id_cotizacion Int

  cotizacion Cotizacion @relation(fields: [id_cotizacion], references: [id_cotizacion])
}

model Equipamento {
  id_equipamento Int @id @default(autoincrement())

  id_proveedor Int

  nombre_equipamento    String
  marca_equipamento     String
  modelo_equipamento    String
  categoria_equipamento String
  estado_equipamento String
  descripcion_equipamento String
  precio_unitario_equipamento Float
  plazo_entrega_dias Int
  garantia_meses     Int
  incluye Json
  fecha_registro DateTime @default(now())
  especificaciones_equipamento String
}

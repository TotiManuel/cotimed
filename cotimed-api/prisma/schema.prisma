generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum TipoDocumento {
  DNI
  CUIL
  CUIT
  PASAPORTE
  OTRO
}
enum RolUsuario{
  ADMIN
  ATENCIONINSTITUCION
  ATENCIONPROVEEDOR
  OTRO
}
model Usuario {
  id Int @id @default(autoincrement())
  nombre String
  apellido String?
  email String @unique
  password String
  telefono String?
  tipo_documento TipoDocumento?
  numero_documento String?
  pais String
  provincia String
  ciudad String
  rol RolUsuario
  ultimo_login DateTime?
  email_verificado Boolean @default(false)
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  eliminado Boolean @default(false)
}
enum EstadoInstitucion {
  PENDIENTE
  VERIFICADO
  BLOQUEADO
}
model Institucion {
  id Int @id @default(autoincrement())
  razon_social String
  nombre_comercial String?
  cuit String? @unique
  descripcion String?
  email String? @unique
  telefono String?
  sitio_web String?
  pais String
  provincia String
  ciudad String
  estado EstadoInstitucion @default(PENDIENTE)
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  eliminado Boolean @default(false)
}
enum EstadoProveedor {
  PENDIENTE
  VERIFICADO
  BLOQUEADO
}
model Proveedor {
  id Int @id @default(autoincrement())
  razon_social String
  nombre_comercial String?
  cuit String? @unique
  descripcion String?
  email String? @unique
  telefono String?
  sitio_web String?
  pais String
  provincia String
  ciudad String
  estado EstadoProveedor @default(PENDIENTE)
  verificado Boolean @default(false)
  fecha_verificacion DateTime?
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  eliminado Boolean @default(false)
}
enum Categoria {
  IMAGENES
  LABORATORIO
  QUIROFANO
}
enum TipoEquipamiento {
  QUIRURGICO
  PROTESIS
  INSUMOS
  UTI
  PISO
}
enum EstadoEquipamiento {
  NUEVO
  USADO
  CONSULTAR
}
enum TipoPrecio {
  UNITARIO
  KIT
  CAJA
}
enum TipoMoneda {
  ARS
  USD
  EUR
}
enum TipoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  FINANCIACION
  CREDITO
  CONTRA_ENTREGA
  CHEQUE
  DEPOSITO_BANCARIO
  PAGO_ANTICIPADO
  PAGO_PARCIAL
  CONTRA_FACTURA
  OTRO
}
model Equipamento {
  id Int @id @default(autoincrement())
  proveedor_id Int
  categoria Categoria
  nombre String
  marca String?
  modelo String?
  numero_parte String?
  codigo_interno String?
  tipo TipoEquipamiento
  descripcion String
  especificaciones String?
  estado EstadoEquipamiento @default(NUEVO)
  precio_unitario Decimal @db.Decimal(15, 2)
  tipo_precio TipoPrecio @default(UNITARIO)
  moneda TipoMoneda @default(ARS)
  stock Int?
  stock_minimo Int?
  plazo_entrega_dias Int?
  garantia_meses Int?
  disponible Boolean @default(true)
  fabricante String?
  origen String?
  registro_sanitario String?
  vida_util_anios Int?
  requiere_instalacion Boolean @default(false)
  requiere_capacitacion Boolean @default(false)
  incluye Json?
  accesorios Json?
  caracteristicas Json?
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  eliminado Boolean @default(false)
}
enum EstadoSolicitud {
  BORRADOR
  COTIZANDO
  EVALUANDO
  CERRADA
}
enum NivelUrgencia {
  BAJA
  MEDIA
  ALTA
  URGENTE
}
model Solicitud {
  id Int @id @default(autoincrement())
  numero String @unique
  titulo String
  descripcion String
  institucion_id Int
  creado_por_id Int
  estado EstadoSolicitud @default(BORRADOR)
  urgencia NivelUrgencia @default(MEDIA)
  fecha_publicacion DateTime?
  fecha_limite_cotizacion DateTime?
  fecha_cierre DateTime?
  presupuesto_estimado Decimal? @db.Decimal(15, 2)
  moneda TipoMoneda @default(ARS)
  condiciones String?
  observaciones String?
  lugar_entrega String?
  requiere_instalacion Boolean @default(false)
  requiere_capacitacion Boolean @default(false)
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  eliminado Boolean @default(false)
}
enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  CANCELADA
  CERRADA
}
model Cotizacion {
  id Int @id @default(autoincrement())
  numero String @unique
  solicitud_id Int
  proveedor_id Int
  ItemCotizacionId Int
  usuario_id Int
  estado EstadoCotizacion @default(BORRADOR)
  moneda TipoMoneda @default(ARS)
  subtotal Decimal @db.Decimal(15, 2)
  impuestos Decimal @default(0) @db.Decimal(15, 2)
  descuento Decimal @default(0) @db.Decimal(15, 2)
  envio Decimal @default(0) @db.Decimal(15, 2)
  total Decimal @db.Decimal(15, 2)
  plazo_entrega_dias Int?
  garantia_meses Int?
  validez_dias Int?
  fecha_vencimiento DateTime?
  condiciones_pago TipoPago?
  condiciones String?
  observaciones String?
  fecha_envio DateTime?
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
}
model ItemCotizacion {
  id Int @id @default(autoincrement())
  cotizacion_id Int
  solicitud_id Int
  equipamento_id Int?
  nombre String
  descripcion String?
  cantidad Int
  precio_unitario Decimal @db.Decimal(15, 2)
  descuento Decimal @default(0) @db.Decimal(15, 2)
  subtotal Decimal @db.Decimal(15, 2)
  impuestos Decimal @default(0) @db.Decimal(15, 2)
  total Decimal @db.Decimal(15, 2)
  plazo_entrega_dias Int?
  garantia_meses Int?
  incluye String?
  observaciones String?
  fecha_creacion DateTime @default(now())
}
 